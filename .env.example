# Signs and verifies JWTs. Required — the app refuses to start without it.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Any SQLAlchemy URL. Defaults to a local SQLite file.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/bookmarks
DATABASE_URL=sqlite:///./bookmarks.db
